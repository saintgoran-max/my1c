// Возвращаемое значение:
//    - Структура 
//            - ИностраннаяОрганизация - Булево
//            - КПП - Строка
//
Функция РеквизитыОрганизацииДляОтчетностиПоНДС(Организация) Экспорт
	
	ПараметрыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Организация, "ИностраннаяОрганизация,КПП");
		
	Возврат Новый Структура("ИностраннаяОрганизация,КПП", 
		ПараметрыОрганизации.ИностраннаяОрганизация, ПараметрыОрганизации.КПП);
	
КонецФункции

