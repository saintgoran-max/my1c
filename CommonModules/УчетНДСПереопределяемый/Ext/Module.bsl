	// В БРУ таких документов нет.
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	"""" КАК Номер,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	"""" КАК КППКонтрагента,
	|	0 КАК СуммаНДСДокумента,
	|	0 КАК СуммаНДСДокументаКомиссия,
	|	0 КАК СуммаДокумента,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ВалютаДокумента,
	|	ЗНАЧЕНИЕ(Документ.ДокументРасчетовСКонтрагентом.ПустаяСсылка) КАК Ссылка
	|ГДЕ
	|	ЛОЖЬ
	|";
	
	Возврат ТекстЗапроса;

КонецФункции

