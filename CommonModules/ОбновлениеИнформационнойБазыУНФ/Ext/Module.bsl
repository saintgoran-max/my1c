Процедура ОбъединитьДеревоСкидокИБонусов(ПараметрыОбработчика) Экспорт
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АвтоматическиеСкидки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АвтоматическиеСкидки КАК АвтоматическиеСкидки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БонусныеПрограммы КАК БонусныеПрограммы
	|		ПО АвтоматическиеСкидки.БонуснаяПрограмма = БонусныеПрограммы.Ссылка
	|ГДЕ
	|	АвтоматическиеСкидки.Действует";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьБонусныеПрограммы") Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	ИначеЕсли РезультатЗапроса.Пустой() Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	КорневоеПравилоСкидок = Константы.ВариантыСовместногоПримененияСкидокНаценок.Получить();
	КорневоеПравилоБонусов = Константы.Удалить_ВариантыСовместногоПримененияНачисленийБонусов.Получить();
	Блокировка = Новый БлокировкаДанных();
	ЭлементБлокировки = Блокировка.Добавить("Справочник.АвтоматическиеСкидки");
	ЭлементБлокировки = Блокировка.Добавить("Константа.ВариантыСовместногоПримененияСкидокНаценок");
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Константы.ВариантыСовместногоПримененияСкидокНаценок.Установить(Перечисления.ВариантыСовместногоПримененияСкидокНаценок.Умножение);

		Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтоматическиеСкидки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АвтоматическиеСкидки КАК АвтоматическиеСкидки
		|		Внутреннее СОЕДИНЕНИЕ Справочник.БонусныеПрограммы КАК БонусныеПрограммы
		|		ПО АвтоматическиеСкидки.БонуснаяПрограмма = БонусныеПрограммы.Ссылка
		|где
		|	АвтоматическиеСкидки.Родитель = Значение(Справочник.АвтоматическиеСкидки.ПустаяСсылка)
		|	И НЕ АвтоматическиеСкидки.СпособПредоставления = ЗНАЧЕНИЕ(Перечисление.СпособыПредоставленияСкидокНаценок.Округление)
		|	И БонусныеПрограммы.УдалитьНачислятьБонусыДоСкидок";
		КорневыеБонусы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если КорневыеБонусы.Количество() > 0 Тогда
			КорневаяГруппаБонусовДоСкидок = Справочники.АвтоматическиеСкидки.СоздатьГруппу();
			КорневаяГруппаБонусовДоСкидок.Наименование = НСтр("ru = 'Бонусы до скидок'");
			КорневаяГруппаБонусовДоСкидок.ЭтоПравилоНачисленияБонусов = Истина;
			КорневаяГруппаБонусовДоСкидок.УдалитьРеквизитДопУпорядочивания = 1;
			КорневаяГруппаБонусовДоСкидок.ВариантСовместногоПрименения = КорневоеПравилоБонусов;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(КорневаяГруппаБонусовДоСкидок);
	
			Для Каждого КорневоеНачисление Из КорневыеБонусы Цикл
				ПравилоНачисленияБонусов = КорневоеНачисление.ПолучитьОбъект();
				ПравилоНачисленияБонусов.Родитель = КорневаяГруппаБонусовДоСкидок.Ссылка;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПравилоНачисленияБонусов);
			КонецЦикла;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтоматическиеСкидки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АвтоматическиеСкидки КАК АвтоматическиеСкидки
		|ГДЕ
		|	АвтоматическиеСкидки.Родитель = ЗНАЧЕНИЕ(Справочник.АвтоматическиеСкидки.ПустаяСсылка)
		|	И НЕ АвтоматическиеСкидки.ЭтоПравилоНачисленияБонусов
		|	И НЕ АвтоматическиеСкидки.СпособПредоставления = ЗНАЧЕНИЕ(Перечисление.СпособыПредоставленияСкидокНаценок.Округление)";
		КорневыеСкидки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если КорневыеСкидки.Количество() > 0 Тогда
			КорневаяГруппаСкидок = Справочники.АвтоматическиеСкидки.СоздатьГруппу();
			КорневаяГруппаСкидок.Наименование = НСтр("ru = 'Автоматические скидки'");
			КорневаяГруппаСкидок.УдалитьРеквизитДопУпорядочивания = 2;
			КорневаяГруппаСкидок.ВариантСовместногоПрименения = КорневоеПравилоСкидок;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(КорневаяГруппаСкидок);
			Для Каждого КорневаяСкидка Из КорневыеСкидки Цикл
				Скидка = КорневаяСкидка.ПолучитьОбъект();
				Скидка.Родитель = КорневаяГруппаСкидок.Ссылка;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Скидка);
			КонецЦикла;
		КонецЕсли;
		 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтоматическиеСкидки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АвтоматическиеСкидки КАК АвтоматическиеСкидки
		|		Внутреннее СОЕДИНЕНИЕ Справочник.БонусныеПрограммы КАК БонусныеПрограммы
		|		ПО АвтоматическиеСкидки.БонуснаяПрограмма = БонусныеПрограммы.Ссылка
		|где
		|	АвтоматическиеСкидки.Родитель = Значение(Справочник.АвтоматическиеСкидки.ПустаяСсылка)
		|	И НЕ АвтоматическиеСкидки.СпособПредоставления = ЗНАЧЕНИЕ(Перечисление.СпособыПредоставленияСкидокНаценок.Округление)
		|	И НЕ БонусныеПрограммы.УдалитьНачислятьБонусыДоСкидок";
		КорневыеБонусы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если КорневыеБонусы.Количество() > 0 Тогда
			КорневаяГруппаБонусовПослеСкидок = Справочники.АвтоматическиеСкидки.СоздатьГруппу();
			КорневаяГруппаБонусовПослеСкидок.Наименование = НСтр("ru = 'Бонусы после скидок'");
			КорневаяГруппаБонусовПослеСкидок.ЭтоПравилоНачисленияБонусов = Истина;
			КорневаяГруппаБонусовПослеСкидок.УдалитьРеквизитДопУпорядочивания = 3;
			КорневаяГруппаБонусовПослеСкидок.ВариантСовместногоПрименения = КорневоеПравилоБонусов;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(КорневаяГруппаБонусовПослеСкидок);
	
			Для Каждого КорневоеНачисление Из КорневыеБонусы Цикл
				ПравилоНачисленияБонусов = КорневоеНачисление.ПолучитьОбъект();
				ПравилоНачисленияБонусов.Родитель = КорневаяГруппаБонусовПослеСкидок.Ссылка;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПравилоНачисленияБонусов);
			КонецЦикла;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
	Исключение
		ОтменитьТранзакцию();
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗарегистрироватьИзмененияОбъектовСПредопределеннымиЭлементами(ПараметрыОбработчика) Экспорт
	
	Если ОбщегоНазначения.ЭтоПодчиненныйУзелРИБ() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АвтономнаяРабота.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.АвтономнаяРабота КАК АвтономнаяРабота
	|ГДЕ
	|	НЕ АвтономнаяРабота.ЭтотУзел
	|	И НЕ АвтономнаяРабота.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Полный.Ссылка
	|ИЗ
	|	ПланОбмена.Полный КАК Полный
	|ГДЕ
	|	НЕ Полный.ЭтотУзел
	|	И НЕ Полный.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СОтборами.Ссылка
	|ИЗ
	|	ПланОбмена.СОтборами КАК СОтборами
	|ГДЕ
	|	НЕ СОтборами.ЭтотУзел
	|	И НЕ СОтборами.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПланыОбмена.ЗарегистрироватьИзменения(Выборка.Ссылка, Метаданные.ПланыВидовХарактеристик.ОбъектыАдресацииЗадач);
		ПланыОбмена.ЗарегистрироватьИзменения(Выборка.Ссылка, Метаданные.Справочники.РолиИсполнителей);
	КонецЦикла;
	
КонецПроцедуры

