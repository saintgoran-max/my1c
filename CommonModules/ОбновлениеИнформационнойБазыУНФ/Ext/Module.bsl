// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковПереходаСДругойПрограммы
Процедура ПриДобавленииОбработчиковПереходаСДругойПрограммы(Обработчики) Экспорт
	
	Если СтрНачинаетсяС(Метаданные.Имя, "Розница") Тогда
		
		Обработчик = Обработчики.Добавить();
		Обработчик.ПредыдущееИмяКонфигурации = "Розница";
		Обработчик.Процедура = "ОбновлениеИнформационнойБазыУНФ.УстановитьСлужебныеФункциональныеОпцииВозможностейПриложений";
		
	Иначе
		
		Обработчик = Обработчики.Добавить();
		Обработчик.ПредыдущееИмяКонфигурации = "Розница";
		Обработчик.Процедура = "ОбновлениеИнформационнойБазыУНФ.ОбновлениеРозницыДоУНФ";
		
		Обработчик = Обработчики.Добавить();
		Обработчик.ПредыдущееИмяКонфигурации = "РозницаБазовая";
		Обработчик.Процедура = "ОбновлениеИнформационнойБазыУНФ.ОбновлениеРозницыДоУНФ";
		
	КонецЕсли;
	
