		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатусыДокументов.ЗаполнитьСтатусыСчетовФактурПоДокументамПередачиМеждуОрганизациями(ПараметрыОбработчика);
	
КонецПроцедуры

Процедура ЗаполнитьНаименованиеСокращенноеОрганизаций(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|	И ДЛИНАСТРОКИ(Организации.НаименованиеСокращенное) = 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	Иначе
		Параметры.ОбработкаЗавершена = Ложь;
	КонецЕсли;
		
	Выборка = РезультатЗапроса.Выбрать();
	
	КлассификаторОПФ = РегламентированныеДанныеПовтИсп.КлассификаторОрганизационноПравовыхФорм();
	
	Пока Выборка.Следующий() Цикл
		Организация = Выборка.Организация;
		НаименованиеСокращенное = СформироватьСокращенноеНаименование(КлассификаторОПФ, Организация.НаименованиеПолное);
		ОрганизацияОбъект = Организация.ПолучитьОбъект();
		
		Попытка
			ОрганизацияОбъект.Заблокировать();
			ОрганизацияОбъект.НаименованиеСокращенное = НаименованиеСокращенное;
			ЗаполнитьИсториюНаименований(ОрганизацияОбъект, КлассификаторОПФ);
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОрганизацияОбъект);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка выполнения обработчика заполнения сокращенного наименования организации'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ОрганизацияОбъект, ПодробноеПредставлениеОшибки);
			
			Параметры.ОбработкаЗавершена = Ложь;
			Возврат;
			
		КонецПопытки;
	КонецЦикла;
	
	НаименованиеПолное = Перечисления.ВидыНаименованийДляПечатиДокументов.Полное;
	Константы.ВидНаименованияОрганизацииДляПечатиДокументов.Установить(НаименованиеПолное);
	
КонецПроцедуры

Процедура ЗаполнитьИсториюНаименований(ОрганизацияОбъект, КлассификаторОПФ)
	Для Каждого СтрокаИстории Из ОрганизацияОбъект.ИсторияНаименований Цикл
		Если ПустаяСтрока(СтрокаИстории.НаименованиеСокращенное) Тогда
			СтрокаИстории.НаименованиеСокращенное = СформироватьСокращенноеНаименование(КлассификаторОПФ, 
				ОрганизацияОбъект.НаименованиеПолное);
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Функция СформироватьСокращенноеНаименование(КлассификаторОПФ, Знач НаименованиеПолное)

	ОрганизационноПравоваяФорма = ВыделитьИзНаименованияОПФ(КлассификаторОПФ, НаименованиеПолное);
	Шаблон = "%1 %2";
	Если ОрганизационноПравоваяФорма.КраткаяФорма = "ИП" Тогда
		ШаблонНаименования = Шаблон;
	Иначе
		ШаблонНаименования = "%1 ""%2""";
	КонецЕсли;
	
	НаименованиеСокращенное = СтрШаблон(ШаблонНаименования,
		ОрганизационноПравоваяФорма.КраткаяФорма, ОрганизационноПравоваяФорма.НаименованиеБезОПФ);
	
	Возврат НаименованиеСокращенное;
	
КонецФункции

Функция ВыделитьИзНаименованияОПФ(КлассификаторОПФ, Знач НаименованиеОрганизации)

	Результат = Новый Структура("НаименованиеБезОПФ, КраткаяФорма, ПолнаяФорма", НаименованиеОрганизации, "", "");
	МассивСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(НаименованиеОрганизации);

	Для Каждого Слово Из МассивСлов Цикл
		Для Каждого ДанныеОПФ Из КлассификаторОПФ Цикл
			Если СледуетВыделитьКомпонентыНаименования(Слово, ДанныеОПФ) Тогда
				Результат.КраткаяФорма = ДанныеОПФ.КраткаяФорма;
				Результат.ПолнаяФорма = ДанныеОПФ.ПолнаяФорма;
				НаименованиеБезОПФ = СокрЛП(СтрЗаменить(НаименованиеОрганизации, Слово, ""));
				Результат.НаименованиеБезОПФ = СтроковыеФункцииКлиентСервер.СократитьДвойныеКавычки(НаименованиеБезОПФ);
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого ДанныеОПФ Из КлассификаторОПФ Цикл
		ПозицияВНаименовании = СтрНайти(ВРег(НаименованиеОрганизации), ВРег(ДанныеОПФ.ПолнаяФорма)); 
		Если ПозицияВНаименовании <> 0 Тогда
			ДлинаПолнойФормы = СтрДлина(ДанныеОПФ.ПолнаяФорма);
			Результат.КраткаяФорма = ДанныеОПФ.КраткаяФорма;
			Результат.ПолнаяФорма = ДанныеОПФ.ПолнаяФорма;
			ОПФВНазвании = Сред(НаименованиеОрганизации, ПозицияВНаименовании, ДлинаПолнойФормы);
			НаименованиеБезОПФ = СокрЛП(СтрЗаменить(НаименованиеОрганизации, ОПФВНазвании, ""));
			Результат.НаименованиеБезОПФ = СтроковыеФункцииКлиентСервер.СократитьДвойныеКавычки(НаименованиеБезОПФ);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СледуетВыделитьКомпонентыНаименования(Слово, ДанныеОПФ)

	Если ВРег(СокрЛП(Слово)) = ВРег(ДанныеОПФ.ПолнаяФорма) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не ПустаяСтрока(ДанныеОПФ.КраткаяФорма) И ВРег(СокрЛП(Слово)) = ВРег(ДанныеОПФ.КраткаяФорма) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ПереместитьШаблоныЧекаККМВНовыйСправочникИЗаменитьВКассахККМ(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 300
		|	ХранилищеШаблонов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ХранилищеШаблонов КАК ХранилищеШаблонов
		|ГДЕ
		|	ХранилищеШаблонов.ТипШаблона = ЗНАЧЕНИЕ(Перечисление.ТипыШаблонов.ЧекККМ)
		|	И ХранилищеШаблонов.УдалитьШаблонЧекаРМК = ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ЗаменитьВКассахККМШаблоныЧековНаНовые(Параметры);
	Иначе
		ПереместитьШаблоныЧекаККМВНовыйСправочник(РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПереместитьШаблоныЧекаККМВНовыйСправочник(РезультатЗапроса)
	
	ТипыУсловий = Новый Соответствие;
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.ВидДисконтнойКарты,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.ВидДисконтнойКарты);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.Сумма,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.Сумма);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.СуммаДоСкидок,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.СуммаДоСкидок);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.СуммаАвтоматическойСкидки,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.СуммаАвтоматическойСкидки);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.СуммаРучнойСкидки,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.СуммаРучнойСкидки);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.СуммаОплатыБонусами,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.СуммаОплатыБонусами);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.СуммаВсехСкидок,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.СуммаВсехСкидок);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.НачисленоБонусов,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.НачисленоБонусов);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.ПокупательИдентифицирован,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.ПокупательИдентифицирован);
	ТипыУсловий.Вставить(Перечисления.УсловиеВыводаСекцииШаблона.ВыдаетсяПромокодНаСкидку,
		Перечисления.УсловиеВыводаСекцииШаблонаРМК.ВыдаетсяПромокодНаСкидку);
	
	ВидыСравнения = Новый Соответствие;
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.Больше,
		Перечисления.ВидСравненияЗначенийРМК.Больше);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.БольшеИлиРавно,
		Перечисления.ВидСравненияЗначенийРМК.БольшеИлиРавно);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.Меньше,
		Перечисления.ВидСравненияЗначенийРМК.Меньше);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.МеньшеИлиРавно,
		Перечисления.ВидСравненияЗначенийРМК.МеньшеИлиРавно);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.Равно,
		Перечисления.ВидСравненияЗначенийРМК.Равно);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.НеРавно,
		Перечисления.ВидСравненияЗначенийРМК.НеРавно);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.ВСписке,
		Перечисления.ВидСравненияЗначенийРМК.ВСписке);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.ВИнтервале,
		Перечисления.ВидСравненияЗначенийРМК.ВИнтервале);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.ВИнтервалеВключая,
		Перечисления.ВидСравненияЗначенийРМК.ВИнтервалеВключая);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.ВИнтервалеВключаяЛево,
		Перечисления.ВидСравненияЗначенийРМК.ВИнтервалеВключаяЛево);
	ВидыСравнения.Вставить(Перечисления.ВидСравненияЗначений.ВИнтервалеВключаяПраво,
		Перечисления.ВидСравненияЗначенийРМК.ВИнтервалеВключаяПраво);
	
	Выборка = РезультатЗапроса.Выбрать();
	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			СтароеХранилищеШаблоновОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СтароеХранилищеШаблоновОбъект.Заблокировать();
			СтруктураШаблона = СтароеХранилищеШаблоновОбъект.Шаблон.Получить();
			СКД = СтароеХранилищеШаблоновОбъект.СхемаКомпоновкиДанных.Получить();
			
			НовоеХранилищеШаблоновРМКОбъект = Справочники.ХранилищеШаблоновРМК.СоздатьЭлемент();
			НовоеХранилищеШаблоновРМКОбъект.Наименование = СтароеХранилищеШаблоновОбъект.Наименование;
			НовоеХранилищеШаблоновРМКОбъект.ПометкаУдаления = СтароеХранилищеШаблоновОбъект.ПометкаУдаления;
			НовоеХранилищеШаблоновРМКОбъект.СхемаКомпоновкиДанных = Новый ХранилищеЗначения(СКД);
			Для Каждого ОписаниеУсловия Из СтароеХранилищеШаблоновОбъект.Условия Цикл
				НовыйТипУсловий   = ТипыУсловий.Получить(ОписаниеУсловия.ТипУсловия);
				НовыйВидСравнения = ВидыСравнения.Получить(ОписаниеУсловия.ВидСравнения);
				Если НовыйТипУсловий = Неопределено ИЛИ НовыйВидСравнения = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НовоеОписаниеУсловия = НовоеХранилищеШаблоновРМКОбъект.Условия.Добавить();
				НовоеОписаниеУсловия.Идентификатор     = ОписаниеУсловия.Идентификатор;
				НовоеОписаниеУсловия.ТипУсловия        = НовыйТипУсловий;
				НовоеОписаниеУсловия.ВидСравнения      = НовыйВидСравнения;
				НовоеОписаниеУсловия.ЗначениеСравнения = ОписаниеУсловия.ЗначениеСравнения;
			КонецЦикла;
			
			Если ТипЗнч(СтруктураШаблона) = Тип("Структура")
				И СтруктураШаблона.Свойство("ТаблицаУсловий") Тогда
				
				СтруктураШаблона.ТаблицаУсловий = НовоеХранилищеШаблоновРМКОбъект.Условия.Выгрузить(,
					"Идентификатор, ТипУсловия, ВидСравнения, ЗначениеСравнения");
			КонецЕсли;
			НовоеХранилищеШаблоновРМКОбъект.Шаблон = Новый ХранилищеЗначения(СтруктураШаблона);
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовоеХранилищеШаблоновРМКОбъект);
			
			СтароеХранилищеШаблоновОбъект.УдалитьШаблонЧекаРМК = НовоеХранилищеШаблоновРМКОбъект.Ссылка;
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(СтароеХранилищеШаблоновОбъект);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаменитьВКассахККМШаблоныЧековНаНовые(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 300
		|	КассыККМ.Ссылка КАК Ссылка,
		|	КассыККМ.УдалитьШаблонЧекаПродажи КАК УдалитьШаблонЧекаПродажи,
		|	КассыККМ.УдалитьШаблонЧекаВозврата КАК УдалитьШаблонЧекаВозврата
		|ПОМЕСТИТЬ КассыККМНеОбработанные
		|ИЗ
		|	Справочник.КассыККМ КАК КассыККМ
		|ГДЕ
		|	(КассыККМ.УдалитьШаблонЧекаПродажи <> ЗНАЧЕНИЕ(Справочник.ХранилищеШаблонов.ПустаяСсылка)
		|				И КассыККМ.ШаблонЧекаПродажи = ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка)
		|				И КассыККМ.УдалитьШаблонЧекаПродажи.ТипШаблона = ЗНАЧЕНИЕ(Перечисление.ТипыШаблонов.ЧекККМ)
		|			ИЛИ КассыККМ.УдалитьШаблонЧекаВозврата <> ЗНАЧЕНИЕ(Справочник.ХранилищеШаблонов.ПустаяСсылка)
		|				И КассыККМ.ШаблонЧекаВозврата = ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка)
		|				И КассыККМ.УдалитьШаблонЧекаВозврата.ТипШаблона = ЗНАЧЕНИЕ(Перечисление.ТипыШаблонов.ЧекККМ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КассыККМНеОбработанные.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(ХранилищеШаблоновЧекаПродажи.УдалитьШаблонЧекаРМК, ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка)) КАК ШаблонЧекаПродажи,
		|	ЕСТЬNULL(ХранилищеШаблоновЧекаВозврата.УдалитьШаблонЧекаРМК, ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка)) КАК ШаблонЧекаВозврата
		|ИЗ
		|	КассыККМНеОбработанные КАК КассыККМНеОбработанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХранилищеШаблонов КАК ХранилищеШаблоновЧекаПродажи
		|		ПО КассыККМНеОбработанные.УдалитьШаблонЧекаПродажи = ХранилищеШаблоновЧекаПродажи.Ссылка
		|			И (ХранилищеШаблоновЧекаПродажи.ТипШаблона = ЗНАЧЕНИЕ(Перечисление.ТипыШаблонов.ЧекККМ))
		|			И (НЕ ХранилищеШаблоновЧекаПродажи.УдалитьШаблонЧекаРМК = ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХранилищеШаблонов КАК ХранилищеШаблоновЧекаВозврата
		|		ПО КассыККМНеОбработанные.УдалитьШаблонЧекаВозврата = ХранилищеШаблоновЧекаВозврата.Ссылка
		|			И (ХранилищеШаблоновЧекаВозврата.ТипШаблона = ЗНАЧЕНИЕ(Перечисление.ТипыШаблонов.ЧекККМ))
		|			И (НЕ ХранилищеШаблоновЧекаВозврата.УдалитьШаблонЧекаРМК = ЗНАЧЕНИЕ(Справочник.ХранилищеШаблоновРМК.ПустаяСсылка))";
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	КассыККМНеОбработанные=ПакетРезультатовЗапроса[0].Выгрузить();
	КассыККМНаОбработку=ПакетРезультатовЗапроса[1];
	
	Если КассыККМНеОбработанные[0].Количество = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Выборка = КассыККМНаОбработку.Выбрать();
	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			КассаККМОбъект = Выборка.Ссылка.ПолучитьОбъект();
			КассаККМОбъект.Заблокировать();
			КассаККМОбъект.ШаблонЧекаПродажи  = Выборка.ШаблонЧекаПродажи;
			КассаККМОбъект.ШаблонЧекаВозврата = Выборка.ШаблонЧекаВозврата;
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(КассаККМОбъект);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
КонецПроцедуры

