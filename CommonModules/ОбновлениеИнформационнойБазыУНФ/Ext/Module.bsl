Процедура ОперацииПодготовкиКРаботеСАкцизами(Параметры) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		
		Параметры.ОбработкаЗавершена = Ложь;
		Продажи_Акцизы = ПланыСчетов.Управленческий.Продажи_Акцизы.ПолучитьОбъект();
		Продажи_Акцизы.Наименование = НСтр("ru='Продажи акцизы'");
		Продажи_Акцизы.Родитель = ПланыСчетов.Управленческий.Продажи;
		Продажи_Акцизы.Вид = ВидСчета.Активный;
		Продажи_Акцизы.ТипСчета = Перечисления.ТипыСчетов.Кредиторы;
		Продажи_Акцизы.СпособРаспределения = Перечисления.БазыРаспределенияРасходов.НеРаспределять;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Продажи_Акцизы);
		
		АкцизыПоОплаченнымМатериальнымЦенностям = ПланыСчетов.Управленческий.АкцизыПоОплаченнымМатериальнымЦенностям.ПолучитьОбъект();
		АкцизыПоОплаченнымМатериальнымЦенностям.Наименование = НСтр("ru='Акцизы по оплаченным материальным ценностям'");
		АкцизыПоОплаченнымМатериальнымЦенностям.Родитель = ПланыСчетов.Управленческий.НДСПоПриобретеннымЦенностям;
		АкцизыПоОплаченнымМатериальнымЦенностям.Вид = ВидСчета.Активный;
		АкцизыПоОплаченнымМатериальнымЦенностям.ТипСчета = Перечисления.ТипыСчетов.Дебиторы;
		АкцизыПоОплаченнымМатериальнымЦенностям.СпособРаспределения = Перечисления.БазыРаспределенияРасходов.НеРаспределять;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(АкцизыПоОплаченнымМатериальнымЦенностям);
		
		Киловатт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214");
		Если Не ЗначениеЗаполнено(Киловатт) Тогда
			Киловатт = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
			Киловатт.Наименование = НСтр("ru = 'кВт'");
			Киловатт.МеждународноеСокращение = НСтр("ru = 'KWT'");
			Киловатт.Код = НСтр("ru = '214'");
			Киловатт.НаименованиеПолное = НСтр("ru = 'Киловатт'");
			Киловатт.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Мощность;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Киловатт);
		КонецЕсли;
		
		ЛошадинаяСила = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("251");
		Если Не ЗначениеЗаполнено(ЛошадинаяСила) Тогда
			ЛошадинаяСила = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
			ЛошадинаяСила.Наименование = НСтр("ru = 'л. с'");
			ЛошадинаяСила.Код = НСтр("ru = '251'");
			ЛошадинаяСила.НаименованиеПолное = НСтр("ru = 'Лошадиная сила'");
			ЛошадинаяСила.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Мощность;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЛошадинаяСила);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		Параметры.ОбработкаЗавершена = Истина;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка подготовки к работе с акцизами'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки);
		
		ОтменитьТранзакцию();
		Параметры.ОбработкаЗавершена = Ложь;
		
	КонецПопытки
	
КонецПроцедуры

Процедура ОбновитьВидыНалоговПоНДФЛ(ПараметрыОбработчика) Экспорт
	
	ЕстьОшибки = Ложь;
	
	НачатьТранзакцию();
	
