&НаСервереБезКонтекста
Функция ОбменПоУзлуЗапланирован(Узел)
	
	УстановитьПривилегированныйРежим(Истина);
	ОбменЗапланирован = ОбменДаннымиВнутренняяПубликация.ПоУзлуЗапланированОбмен(Узел);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ОбменЗапланирован;
	
КонецФункции  

&НаКлиенте
Процедура ОбработкаОжиданияФоновогоОбменаПоСценарию()

	ОбменЗапланирован = ОбменПоУзлуЗапланирован(УзелОбмена);
	Если ОбменЗапланирован Тогда   
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаОжидание;
		Элементы.ПодстраницыОжидания.ТекущаяСтраница = Элементы.СтраницаОжиданиеФоновогоОбмена;  
		
		ПодключитьОбработчикОжидания("ОбработкаОжиданияФоновогоОбменаПоСценарию", 20, Истина);   
		Возврат;    
	Иначе  
		
		// 1 и 2 этапы отражения
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаОжидание;
		Элементы.ПодстраницыОжидания.ТекущаяСтраница = Элементы.СтраницаРегистрацияКОтправке;
		КомандаОтразитьДокументыНаСервере();
		
		// 3. Запуск обмена. 
		ДлительнаяОперация = Неопределено;
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаОжидание;
		Элементы.ПодстраницыОжидания.ТекущаяСтраница = Элементы.СтраницаОтправкаДокументов;
		ПодключитьОбработчикОжидания("НачатьСинхронизацию", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция СравнитьКэшИРеквизиты()    
	
	БылиДополняющиеИзменения = СравнитьКэшОрганизацийИРеквизиты();
	
	Для Каждого СтрокаРаздела Из РазделыУчета Цикл     
		СтрокиКэша = КэшРазделыУчета.НайтиСтроки(Новый Структура("Идентификатор", СтрокаРаздела.Идентификатор)); 
		Если СтрокиКэша.Количество() = 1 Тогда  
			СтрокаКэша = СтрокиКэша[0];
			Если СтрокаРаздела.Пометка И Не СтрокаКэша.Пометка Тогда
				БылиИзменения = Истина;
				БылиДополняющиеИзменения = Истина;
			ИначеЕсли Не СтрокаРаздела.Пометка И СтрокаКэша.Пометка Тогда
				БылиИзменения = Истина; 
			КонецЕсли;
		ИначеЕсли СтрокиКэша.Количество() = 0 Тогда  
			БылиИзменения = Истина;
			БылиДополняющиеИзменения = Истина;
		КонецЕсли;
	КонецЦикла;   
	
	Если ДатаНачалаОтражения < КэшДатаНачалаОтражения Тогда
		БылиИзменения = Истина;
		БылиДополняющиеИзменения = Истина;
	ИначеЕсли ДатаНачалаОтражения > КэшДатаНачалаОтражения Тогда
		БылиИзменения = Истина; 
	КонецЕсли;   
	
	Возврат БылиДополняющиеИзменения;
	
КонецФункции

&НаСервере
Функция СравнитьКэшОрганизацийИРеквизиты(ВсеИзменения = Ложь)    
	
	БылиИзменения = Ложь;
	БылиДополняющиеИзменения = Ложь;
	Для Каждого СтрокаОрганизации Из ДоступныеОрганизации Цикл     
		СтрокиКэша = КэшДоступныеОрганизации.НайтиСтроки(Новый Структура("КлючСтроки", СтрокаОрганизации.КлючСтроки)); 
		Если СтрокиКэша.Количество() = 1 Тогда  
			СтрокаКэша = СтрокиКэша[0];
			Если СтрокаОрганизации.Пометка И Не СтрокаКэша.Пометка Тогда
				БылиИзменения = Истина;
				БылиДополняющиеИзменения = Истина;
			ИначеЕсли Не СтрокаОрганизации.Пометка И СтрокаКэша.Пометка Тогда
				БылиИзменения = Истина; 
			КонецЕсли;    
		ИначеЕсли СтрокиКэша.Количество() = 0 Тогда  
			БылиИзменения = Истина;
			БылиДополняющиеИзменения = Истина;
		КонецЕсли;
	КонецЦикла;   

	Если ВсеИзменения Тогда
		Возврат БылиИзменения;
	Иначе
		Возврат БылиДополняющиеИзменения;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ДействияПриВключенииОтраженияДокументовНаСервере()
	
	Отказ = Ложь;
	
	// 1. Сохранить выбранные настройки.
	СохранитьВыбранныеНастройкиНаСервере();
	
	// 2. Планирование обмена.    
	ЗапросСценария = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СценарииОбменовДаннымиНастройкиОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК СценарииОбменовДаннымиНастройкиОбмена
	|ГДЕ
	|	СценарииОбменовДаннымиНастройкиОбмена.УзелИнформационнойБазы = &УзелОбмена");
	ЗапросСценария.УстановитьПараметр("УзелОбмена", УзелОбмена);
	
	Результат = ЗапросСценария.Выполнить();
	Если Результат.Пустой() Тогда
		СценарийОбменаДанными = Справочники.СценарииОбменовДанными.СоздатьЭлемент();
		СценарийОбменаДанными.УстановитьНовыйКод();
		СценарийОбменаДанными.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Автоматическая синхронизация данных с %1'"), Строка(УзелОбмена));
		СценарийОбменаДанными.ИспользоватьРегламентноеЗадание = Истина;
			
		// Создаем регламентное задание.
		Расписание = Справочники.СценарииОбменовДанными.РасписаниеРегламентногоЗаданияПоУмолчанию();
		Справочники.СценарииОбменовДанными.ОбновитьДанныеРегламентногоЗадания(Отказ, Расписание, СценарийОбменаДанными);
		
		Если Не Отказ Тогда
			СтрокаНастройкиОбмена = СценарийОбменаДанными.НастройкиОбмена.Добавить();
			СтрокаНастройкиОбмена.ИдентификаторТранспорта = "SM";
			СтрокаНастройкиОбмена.ВыполняемоеДействие = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
			СтрокаНастройкиОбмена.УзелИнформационнойБазы = УзелОбмена;
			
			СтрокаНастройкиОбмена = СценарийОбменаДанными.НастройкиОбмена.Добавить();
			СтрокаНастройкиОбмена.ИдентификаторТранспорта = "SM";
			СтрокаНастройкиОбмена.ВыполняемоеДействие = Перечисления.ДействияПриОбмене.ЗагрузкаДанных;
			СтрокаНастройкиОбмена.УзелИнформационнойБазы = УзелОбмена;
			
			СценарийОбменаДанными.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
 Процедура ДействияПриНачалеРаботыПослеСохраненияНастроекНаКлиенте()     

	Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Истина;
	Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаОжидание;
	Элементы.ПодстраницыОжидания.ТекущаяСтраница = Элементы.СтраницаОтправкаОрганизаций;
	 
	// 1. Получение настроек бухгалтерии для оценки пустоты  
	 ПолучитьНастройкиБухгалтерии();
	 
КонецПроцедуры      

&НаКлиенте
Процедура ВключитьОтражениеОрганизаций()   
	
	КлючиОрганизацийДляОтправки = Новый Массив;
	КлючиОтмеченныхОрганизаций = Новый Массив;
	МассивОрганизацийДляОтправки = Новый Массив;
	Для Каждого СтрокаОрганизации Из ДоступныеОрганизации.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		КлючиОтмеченныхОрганизаций.Добавить(СтрокаОрганизации.КлючСтроки);
		Если ПустаяСтрока(СтрокаОрганизации.ПубличныйИдентификатор) Тогда
			КлючиОрганизацийДляОтправки.Добавить(СтрокаОрганизации.КлючСтроки);
			МассивОрганизацийДляОтправки.Добавить(СтрокаОрганизации.Ссылка);
		КонецЕсли; 
		УстановитьОформлениеЭлементовОрганизации(СтрокаОрганизации.КлючСтроки, Истина);       
	КонецЦикла;    
	
	Если КлючиОрганизацийДляОтправки.Количество() > 0 Тогда 
		ДлительнаяОперация = ДлительнаяОперацияВыгрузитьНесколькоОрганизаций(УзелОбмена, МассивОрганизацийДляОтправки, УникальныйИдентификатор);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("КлючиОрганизаций", КлючиОрганизацийДляОтправки);
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ДлительнаяОперация,
			Новый ОписаниеОповещения("ВыгрузитьНесколькоОрганизацийЗавершение", ЭтотОбъект, ДополнительныеПараметры),
			ПараметрыОжидания);    
	Иначе
		ПолучитьСостояниеУчетнойПолитикиОрганизаций(КлючиОтмеченныхОрганизаций);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСинхронизациюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	СинхронизацияВыполнена = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если СинхронизацияВыполнена Тогда
		ОткрытьФорму("Обработка.ОтражениеДокументовВБухгалтерии.Форма.РазделБухгалтерия");	
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьВыбранныеНастройкиНаСервере()
	
	НачатьТранзакцию();
	Попытка
		НастройкаОбъект = ТекущаяНастройка.ПолучитьОбъект();
		УзелОбъект = УзелОбмена.ПолучитьОбъект();
		
		НастройкаОбъект.ОтражениеВключено = ОтражениеВключено;
		
		НастройкаОбъект.ДатаНачалаОтражения = ДатаНачалаОтражения;
		УзелОбъект.ДатаНачалаВыгрузкиДокументов = ДатаНачалаОтражения;
		
		НастройкаОбъект.Организации.Очистить();
		УзелОбъект.Организации.Очистить();
		Для Каждого СтрокаОрганизация Из ДоступныеОрганизации Цикл
			Если Не СтрокаОрганизация.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = НастройкаОбъект.Организации.Добавить();
			НоваяСтрока.Организация = СтрокаОрганизация.Ссылка;
			
			НоваяСтрока = УзелОбъект.Организации.Добавить();
			НоваяСтрока.Организация = СтрокаОрганизация.Ссылка;
		КонецЦикла;
		УзелОбъект.ИспользоватьОтборПоОрганизациям = УзелОбъект.Организации.Количество() > 0;
		
		НастройкаОбъект.РазделыУчета.Очистить();
		НастройкаОбъект.ВидыДокументов.Очистить();
		
		УзелОбъект.ВидыДокументов.Очистить();
		ДоступныеВидыДокументов = СовместноеИспользование.СоответствиеВидовДокументовИРазделовУчета();
		
		Для Каждого СтрокаРаздел Из РазделыУчета.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
			НоваяСтрокаРаздел = НастройкаОбъект.РазделыУчета.Добавить();
			НоваяСтрокаРаздел.Идентификатор = СтрокаРаздел.Идентификатор;
			
			Если Не СтрокаРаздел.ПоВсемДокументам Тогда
				СтрокиВидыДокументов = ВыбранныеВидыДокументов.НайтиСтроки(Новый Структура("РазделУчета", СтрокаРаздел.Идентификатор));
				Для Каждого СтрокаВидыДокументов Из СтрокиВидыДокументов Цикл
					// Настройка отражения.
					НоваяСтрока = НастройкаОбъект.ВидыДокументов.Добавить();
					НоваяСтрока.РазделУчета = СтрокаРаздел.Идентификатор;
					НоваяСтрока.ИдентификаторМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтрокаВидыДокументов.ПолноеИмяМетаданных);
					
					// Узел обмена.
					НоваяСтрока = УзелОбъект.ВидыДокументов.Добавить();
					НоваяСтрока.ИмяОбъектаМетаданных = СтрокаВидыДокументов.ИмяОбъекта;
					НоваяСтрока.Представление = СтрокаВидыДокументов.Представление;
				КонецЦикла;
			Иначе
				Для Каждого СтрокаВидыДокументов Из ДоступныеВидыДокументов.НайтиСтроки(Новый Структура("РазделУчета", СтрокаРаздел.Идентификатор)) Цикл
					// Узел обмена.
					НоваяСтрока = УзелОбъект.ВидыДокументов.Добавить();
					НоваяСтрока.ИмяОбъектаМетаданных = СтрокаВидыДокументов.ИмяОбъектаМетаданных;
					НоваяСтрока.Представление = СтрокаВидыДокументов.Представление;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		УзелОбъект.ИспользоватьОтборПоВидамДокументов = УзелОбъект.ВидыДокументов.Количество() > 0;
		
		УзелОбъект.ПравилаОтправкиДокументов = "АвтоматическаяСинхронизация";
		
		НастройкаОбъект.Записать();
		УзелОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	НастройкиСинхронизации = Новый Структура;
	НастройкиСинхронизации.Вставить("ПравилаОтправкиСправочников", "СинхронизироватьПоНеобходимости");
	НастройкиСинхронизации.Вставить("ПравилаОтправкиДокументов", "АвтоматическаяСинхронизация");
	
	УстановитьПривилегированныйРежим(Истина);
	ОписаниеПодключения = СовместноеИспользованиеИнтеграция.НовоеПодключениеКСервису();
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = СовместноеИспользованиеИнтеграция.УстановитьНастройкиСовместногоИспользования(ОписаниеПодключения, ТекущаяНастройка, НастройкиСинхронизации);
	
	ОписаниеПодключения.ЗавершитьСеанс = Истина;
	СовместноеИспользованиеИнтеграция.ВерсияИнтерфейса(ОписаниеПодключения);
	
	Если Результат <> Истина Тогда
		ВызватьИсключение НСтр("ru = 'Настройки отражения в бухгалтерии не сохранены.'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРегистрациюИзмененийДляНачальнойВыгрузки()       
	
	СоставПлана = Новый Массив;
	Для Каждого ЭлементСостава Из Метаданные.ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Состав Цикл
		СоставПлана.Добавить(ЭлементСостава.Метаданные);
	КонецЦикла;

	МассивДокументов = Новый Массив;
	Для Каждого СтрокаДокумента Из ДокументыКВыгрузке Цикл   
		МетаданныеДокумента = СтрокаДокумента.Ссылка.Метаданные();   
		Если СоставПлана.Найти(МетаданныеДокумента) <> Неопределено Тогда
			МассивДокументов.Добавить(СтрокаДокумента.Ссылка);
		КонецЕсли;
	КонецЦикла;   
	Если МассивДокументов.Количество() > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, МассивДокументов);
		ДокументыКВыгрузке.Очистить();  
	КонецЕсли;
	АктуализироватьКэши();
	ПроизвестиПолныйПересчетДокументовПоРазделам();
	УстановитьСвойстваКомандыОтразитьДокументы(); 
	
КонецПроцедуры    

&НаСервере
Процедура АктуализироватьКэши()
	КэшДатаНачалаОтражения = ДатаНачалаОтражения;
	КэшДоступныеОрганизации.Загрузить(ДоступныеОрганизации.Выгрузить());
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеЭлементовОрганизации(КлючОрганизации, ДлительнаяОперация = Ложь)
	
	ДанныеПоОрганизации = ДоступныеОрганизации.НайтиСтроки(Новый Структура("КлючСтроки", КлючОрганизации))[0];
	
	ИмяФлажка = "Организация_" + КлючОрганизации;
	ЭлементФлажок = Элементы[ИмяФлажка];
	ЭлементНадпись = Элементы["ДекорацияНадписьСтатусОрганизация_" + КлючОрганизации];
	ЭлементКартинка = Элементы["ДекорацияКартинкаСтатусОрганизация_" + КлючОрганизации];

	ЭлементКнопка = Элементы["КомандаОрганизации_" + КлючОрганизации];
	Если ДанныеПоОрганизации.Пометка И Не ДлительнаяОперация Тогда
		ЭлементКнопка.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Иначе
		ЭлементКнопка.Шрифт = ШрифтыСтиля.ОбычныйШрифтТекста;
	КонецЕсли;
	
	ЭлементНадпись.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;
	
	Если ДлительнаяОперация Тогда
		ЭлементФлажок.Доступность = Ложь;
		
		ЭлементНадпись.Заголовок = НСтр("ru = 'Проверка настроек...'");
		ЭлементНадпись.Видимость = Истина;
		
		ЭлементКартинка.Видимость = Истина;
		ЭлементКартинка.Картинка = БиблиотекаКартинок.ДлительнаяОперация16;
	Иначе
		ЭлементФлажок.Доступность = Истина;
		
		Если ДанныеПоОрганизации.ЕстьНезаполненныеРеквизиты Тогда
			ЭлементНадпись.Заголовок = ДанныеПоОрганизации.ОшибкиПроверкиЗаполнения;
			ЭлементНадпись.ЦветТекста = ЦветаСтиля.НезаполненныйРеквизит;
			ЭлементНадпись.Видимость = Истина;
			
			ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаСПредупреждениями;
			ЭлементКартинка.Видимость = Истина;
			Возврат;
		Иначе
			ЭлементНадпись.Заголовок = "";
			ЭлементНадпись.Видимость = Ложь;
			
			ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаБезПредупреждений;
			ЭлементКартинка.Видимость = Ложь;
		КонецЕсли;
		
		Если Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость Тогда
			Если ДанныеПоОрганизации.Пометка Тогда
 				ЭлементКартинка.Видимость = Истина;    
				
				Если ДанныеПоОрганизации.ОшибкаВыгрузки Тогда
					ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаСПредупреждениями;
					ЭлементНадпись.Заголовок = НСтр("ru = 'Не удалось сравнить сведения'");
					ЭлементНадпись.Видимость = Истина;
				ИначеЕсли ДанныеПоОрганизации.БылЗапросПолитики
					И Не ДанныеПоОрганизации.УчетнаяПолитикаСуществует
					И Не ДанныеПоОрганизации.СистемаНалогообложенияСуществует Тогда
					ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаСПредупреждениями;
					
					ЭлементНадпись.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
						НСтр("ru = 'Необходимо настроить <a href=""НастройкаУчетнойПолитики_%1"
							">учетную политику</a> и <a href=""НастройкаСистемыНалогообложения_%1"
							">систему налогобложения</a>'"),
						КлючОрганизации);
					ЭлементНадпись.Видимость = Истина;
				ИначеЕсли ДанныеПоОрганизации.БылЗапросПолитики
					И Не ДанныеПоОрганизации.УчетнаяПолитикаСуществует Тогда
					ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаСПредупреждениями;
					
					ЭлементНадпись.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
						НСтр("ru = 'Необходимо настроить <a href=""НастройкаУчетнойПолитики_%1"">учетную политику</a>'"),
						КлючОрганизации);
					ЭлементНадпись.Видимость = Истина;
				ИначеЕсли ДанныеПоОрганизации.БылЗапросПолитики
					И Не ДанныеПоОрганизации.СистемаНалогообложенияСуществует Тогда
					ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаСПредупреждениями;
					
					ЭлементНадпись.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
						НСтр("ru = 'Необходимо настроить <a href=""НастройкаСистемыНалогообложения_%1"">систему налогобложения</a>'"),
						КлючОрганизации);
					ЭлементНадпись.Видимость = Истина;
				ИначеЕсли ДанныеПоОрганизации.БылЗапросПолитики Тогда
					ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаБезПредупреждений;
					ЭлементКартинка.Видимость = Истина;
					
					ЭлементНадпись.Видимость = Ложь;
				Иначе
					ЭлементКартинка.Видимость = Ложь;
				    ЭлементНадпись.Видимость = Ложь;
				КонецЕсли;
			ИначеЕсли ДанныеПоОрганизации.ОшибкаВыгрузки Тогда
 				ЭлементНадпись.Заголовок = НСтр("ru = 'Не удалось сравнить сведения'");
				ЭлементНадпись.ЦветТекста = ЦветаСтиля.НезаполненныйРеквизит;
				ЭлементНадпись.Видимость = Истина;
				
				ЭлементКартинка.Видимость = Истина;    
				ЭлементКартинка.Картинка = БиблиотекаКартинок.РазделУчетаСПредупреждениями;
			Иначе
				ЭлементКартинка.Видимость = Ложь;
				ЭлементНадпись.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьОтражениеОрганизацийЗавершение(КлючиОрганизаций, Успешно = Истина, СообщениеОбОшибке = "")

	Для Каждого КлючОрганизации Из КлючиОрганизаций Цикл 
		СтрокиОрганизации = ДоступныеОрганизации.НайтиСтроки(Новый Структура("КлючСтроки", КлючОрганизации));
		СтрокиОрганизации[0].Пометка = Успешно;   
		СтрокиОрганизации[0].ОшибкаВыгрузки = Ложь;
		Если Не Успешно Тогда    
			СтрокиОрганизации[0].ОшибкаВыгрузки = Истина;
			Если ОтражениеВключено Тогда
				ОтражениеВключено = Ложь;
				ОтключитьМеханизмОтраженияДокументовНаСервере();
			КонецЕсли;
		КонецЕсли;  
		УстановитьОформлениеЭлементовОрганизации(КлючОрганизации);
	КонецЦикла;
	
	Если Не Успешно Тогда    
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Истина;
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаНеудача;
		Элементы.ГруппаКомандаНачать.Доступность = Истина;                
		ИзменитьДоступностьФлажковОрганизаций(Истина);
		Элементы.ГруппаДатаНачалаОтражения.Доступность = Истина;   
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСостояниеУчетнойПолитикиОрганизаций(КлючиОрганизаций, ТолькоПолучениеСведений = Ложь)
	
	ПубличныеИдентификаторы = Новый Массив;
	Для Каждого СтрокаОрганизации Из ДоступныеОрганизации Цикл
		Если КлючиОрганизаций.Найти(СтрокаОрганизации.КлючСтроки) <> Неопределено Тогда
			ПубличныеИдентификаторы.Добавить(СтрокаОрганизации.ПубличныйИдентификатор);   
			СтрокаОрганизации.БылЗапросПолитики = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ДлительнаяОперация = ДлительнаяОперацияУчетнаяПолитикаОрганизации(
		ПубличныеИдентификаторы,
		ДатаНачалаОтражения,
		УникальныйИдентификатор);
		
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КлючиОрганизаций", КлючиОрганизаций);
	ДополнительныеПараметры.Вставить("ТолькоПолучениеСведений", ТолькоПолучениеСведений);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("ПолучитьУчетнуюПолитикуОрганизацииЗавершение", ЭтотОбъект, ДополнительныеПараметры),
		ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьНесколькоОрганизацийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда        
		ВключитьОтражениеОрганизацийЗавершение(ДополнительныеПараметры.КлючиОрганизаций, Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда     
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		ВключитьОтражениеОрганизацийЗавершение(ДополнительныеПараметры.КлючиОрганизаций, Ложь, КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если РезультатВыгрузки.Отказ Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатВыгрузки.СообщениеОбОшибке);
		ВключитьОтражениеОрганизацийЗавершение(ДополнительныеПараметры.КлючиОрганизаций, Ложь);  
		ОтразитьЭлементыВторогоЭтапа(Истина);
		Возврат;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	Для Каждого КлючОрганизации Из ДополнительныеПараметры.КлючиОрганизаций Цикл 
		СтрокиОрганизации = ДоступныеОрганизации.НайтиСтроки(Новый Структура("КлючСтроки", КлючОрганизации)); 
		МассивСсылок.Добавить(СтрокиОрганизации[0].Ссылка);
	КонецЦикла;
	Идентификаторы = ПубличныеИдентификаторыОрганизаций(УзелОбмена, МассивСсылок);
	
	Для Каждого КлючОрганизации Из ДополнительныеПараметры.КлючиОрганизаций Цикл 
		СтрокиОрганизации = ДоступныеОрганизации.НайтиСтроки(Новый Структура("КлючСтроки", КлючОрганизации)); 
		СтрокиОрганизации[0].ПубличныйИдентификатор = Идентификаторы.Получить(СтрокиОрганизации[0].Ссылка);   
	КонецЦикла;
	
	ПолучитьСостояниеУчетнойПолитикиОрганизаций(ДополнительныеПараметры.КлючиОрганизаций);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьУчетнуюПолитикуОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КлючиОрганизаций = ДополнительныеПараметры.КлючиОрганизаций;
	
	Если Результат = Неопределено Тогда
		ВключитьОтражениеОрганизацийЗавершение(КлючиОрганизаций, Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		ВключитьОтражениеОрганизацийЗавершение(КлючиОрганизаций, Ложь, КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	СостояниеУчетнойПолитики = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	ЕстьОшибкаПередачи = Ложь;
	Для Каждого КлючОрганизации Из КлючиОрганизаций Цикл
		СтрокиОрганизации = ДоступныеОрганизации.НайтиСтроки(Новый Структура("КлючСтроки", КлючОрганизации));   
		СостояниеНастройки = СостояниеУчетнойПолитики.Получить(СтрокиОрганизации[0].ПубличныйИдентификатор);
		Если СостояниеНастройки <> Неопределено Тогда
			СтрокиОрганизации[0].УчетнаяПолитикаСуществует = СостояниеНастройки.Получить("УчетнаяПолитика").Получить("Существует");
			СтрокиОрганизации[0].СистемаНалогообложенияСуществует = СостояниеНастройки.Получить("СистемаНалогообложения").Получить("Существует");
		Иначе
			СтрокиОрганизации[0].ОшибкаВыгрузки = Истина;
			СтрокиОрганизации[0].УчетнаяПолитикаСуществует = Ложь;
			СтрокиОрганизации[0].СистемаНалогообложенияСуществует = Ложь;  
			ЕстьОшибкаПередачи = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючОрганизации Из КлючиОрганизаций Цикл
		УстановитьОформлениеЭлементовОрганизации(КлючОрганизации);
	КонецЦикла;      
	
	Если ДополнительныеПараметры.ТолькоПолучениеСведений Тогда   
		Возврат;
	КонецЕсли;
	
	ОтразитьЭлементыВторогоЭтапа(ЕстьОшибкаПередачи);
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтразитьЭлементыВторогоЭтапа(ЕстьОшибкаПередачи)

	Элементы.ГруппаКомандаНачать.Доступность = Истина;    
	ИзменитьДоступностьФлажковОрганизаций(Истина);
	Элементы.ГруппаДатаНачалаОтражения.Доступность = Истина;   
	Элементы.КомандаСохранитьНастройки.Доступность = Истина;    
	Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаПараметрыДокументов;
	
	Если ЕстьОшибкаПередачи  Тогда
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Ложь;
	Иначе
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Истина;
		Элементы.ГруппаОтражениеВключено.Видимость = Истина;
		Элементы.КомандаОтразитьДокументы.КнопкаПоУмолчанию = Истина;
		Элементы.ГруппаИнформация.Видимость = Ложь;   
		Элементы.КомандаНачатьРаботу.Видимость = Ложь;    
		Элементы.КомандаОрганизацииВыбраны.Видимость = Ложь;    

		ПроизвестиПолныйПересчетДокументовПоРазделам();   
		УстановитьСвойстваКомандыОтразитьДокументы(); 
		АктуализироватьКэши();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыборИзМенюОтборПоВидамДокументовЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиРазделы = РазделыУчета.НайтиСтроки(Новый Структура("Идентификатор", ДополнительныеПараметры.ИдентификаторРаздела));
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ОтметкаВидовДокументовПоРазделуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ВыборВидовДокументов = ПодготовитьВыборВидовДокументовПоРазделу(ДополнительныеПараметры.ИдентификаторРаздела);
	Если ВыбранныйЭлемент.Значение = "ПоВсемДокументам" Тогда
		СтрокиРазделы[0].ПоВсемДокументам = Истина;
		
		СписокВыбора = ВыборВидовДокументов.СписокВыбора;
		Для Каждого Элемент Из СписокВыбора Цикл
			Элемент.Пометка = Истина;
		КонецЦикла;
		ВыполнитьОбработкуОповещения(ОбработкаВыбора, ВыборВидовДокументов.СписокВыбора);
	ИначеЕсли ВыбранныйЭлемент.Значение = "ВыбратьИзСписка" Тогда
		СтрокиРазделы[0].ПоВсемДокументам = Ложь;
		
		ВыборВидовДокументов.СписокВыбора.ПоказатьОтметкуЭлементов(
			ОбработкаВыбора,
			ВыборВидовДокументов.Заголовок);
	КонецЕсли;  
		
КонецПроцедуры

&НаКлиенте
Процедура ОтметкаВидовДокументовПоРазделуЗавершение(СписокВыбора, ДополнительныеПараметры) Экспорт
	
	Если СписокВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("РазделУчета", ДополнительныеПараметры.ИдентификаторРаздела);
	Для Каждого СтрокаВыбранные Из ВыбранныеВидыДокументов.НайтиСтроки(Отбор) Цикл
		ВыбранныеВидыДокументов.Удалить(СтрокаВыбранные);
	КонецЦикла;
	
	Для Каждого Элемент Из СписокВыбора Цикл
		Если Элемент.Пометка Тогда
			НоваяСтрока = ВыбранныеВидыДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьСвойстваКомандыВидыДокументов(ДополнительныеПараметры.ИмяКоманды, ДополнительныеПараметры.ИдентификаторРаздела);

	КоличествоКВыгрузке = ПодсчитатьКоличествоДокументовПоРазделу(СписокВыбора, ДополнительныеПараметры.ИдентификаторРаздела);  
	УстановитьСвойстваСтрокиРаздела(ДополнительныеПараметры.ИдентификаторРаздела, КоличествоКВыгрузке);   
	УстановитьСвойстваКомандыОтразитьДокументы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьМеханизмОтраженияДокументов()
	
	Если Не ЗначениеЗаполнено(НомерОбласти) Тогда
		ОбработчикВыбора = Новый ОписаниеОповещения("ВыборПриложенияБухгалтерииЗавершение", ЭтотОбъект);
	
		СписокВыбора = Новый СписокЗначений;
		Для Каждого ОписаниеПриложения Из ПриложенияБухгалтерии Цикл
			ПредставлениеПриложения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1 (%2)'"),
				ОписаниеПриложения.Наименование,
				Формат(ОписаниеПриложения.Код, "ЧГ=0"));
			СписокВыбора.Добавить(ОписаниеПриложения.Код, ПредставлениеПриложения);
		КонецЦикла;
		
		Если СписокВыбора.Количество() = 0 Тогда
			ПоказатьПредупреждение(
				Новый ОписаниеОповещения("ПредупреждениеНетДоступныхПриложенийБухгалтерииЗавершение", ЭтотОбъект),
				НСтр("ru = 'Нет доступных приложений бухгалтерии.'"));
		ИначеЕсли СписокВыбора.Количество() = 1 Тогда
			ВыполнитьОбработкуОповещения(ОбработчикВыбора, СписокВыбора[0]);
		Иначе
			СписокВыбора.ПоказатьВыборЭлемента(ОбработчикВыбора, НСтр("ru = 'Приложение бухгалтерии'"));
		КонецЕсли;
	Иначе
		ПослеВыбораПриложенияБухгалтерии();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеНетДоступныхПриложенийБухгалтерииЗавершение(ДополнительныеПараметры) Экспорт
	
	ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПриложенияБухгалтерииЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
		Возврат;
	КонецЕсли;
	
	НомерОбласти = ВыбранныйЭлемент.Значение;
	
	СтрокиПриложения = ПриложенияБухгалтерии.НайтиСтроки(Новый Структура("Код", НомерОбласти));
	
	ОписаниеПриложения = Новый Структура("Код,АдресПриложения,Наименование");
	ЗаполнитьЗначенияСвойств(ОписаниеПриложения, СтрокиПриложения[0]);
	
	УстановитьПараметрыПодключенияКБухгалтерииНаСервере(ОписаниеПриложения);
	
	ПослеВыбораПриложенияБухгалтерии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПриложенияБухгалтерии()
	
	Если УзелОбмена.Пустая() Тогда
		ДлительнаяОперация = ДлительнаяОперацияНастройкиПодключенияКПриложениюВСервисе(НомерОбласти, УникальныйИдентификатор);
	
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ДлительнаяОперация,
			Новый ОписаниеОповещения("ПолучитьНастройкиПодключенияКПриложениюВСервисеЗавершение", ЭтотОбъект),
			ПараметрыОжидания);
	Иначе
		Если НастройкаСинхронизацииЗавершена Тогда
			ВключитьМеханизмОтраженияДокументовЗавершение();
		Иначе
			ДлительнаяОперация = ДлительнаяОперацияСохранитьНачальныеНастройкиСинхронизации(ТекущаяНастройка);
	
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
			
			ДлительныеОперацииКлиент.ОжидатьЗавершение(
				ДлительнаяОперация,
				Новый ОписаниеОповещения("СохранитьНачальныеНастройкиСинхронизацииЗавершение", ЭтотОбъект),
				ПараметрыОжидания);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьПараметрыПодключенияКБухгалтерииНаСервере(ОписаниеПриложения)

	РегистрыСведений.НастройкиИнтеграцииСБухгалтерией.УстановитьПараметрыПодключенияКБухгалтерии(ОписаниеПриложения);

КонецПроцедуры

&НаКлиенте
Процедура ВключитьМеханизмОтраженияДокументовЗавершение(Успешно = Истина, СообщениеОбОшибке = "")
	
	Элементы.ДекорацияОжиданиеИспользоватьОтражение.Видимость = Ложь;
	Элементы.ОтражениеВключено.Доступность = Истина;
	
	ОтражениеВключено = Успешно;
	Если ОтражениеВключено Тогда 
		ДействияПриВключенииОтраженияДокументовНаСервере();  
		ДействияПриНачалеРаботыПослеСохраненияНастроекНаКлиенте();  
		
		Элементы.ГруппаНастройкиОтраженияПервыйЭтап.Доступность = Истина; 
	Иначе
		Элементы.ГруппаНастройкиОтраженияПервыйЭтап.Доступность = Ложь; 
	
		Элементы.ГруппаКомандаНачать.Доступность = Истина;   
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Истина;
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаНеудача;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьМеханизмОтраженияДокументов()
	
	ОтключитьМеханизмОтраженияДокументовНаСервере();

	Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Ложь;      
	ОтмеченныеСтроки = ДоступныеОрганизации.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если ОтмеченныеСтроки.Количество() = 0 Тогда
		Элементы.ГруппаКомандаНачать.Видимость = Ложь;
	КонецЕсли;   
	Оповестить("ОтражениеОтключено");
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьМеханизмОтраженияДокументовНаСервере()
	
	НачатьТранзакцию();
	Попытка
		НастройкаОбъект = ТекущаяНастройка.ПолучитьОбъект();
		НастройкаОбъект.ОтражениеВключено = Ложь;   
		НастройкаОбъект.Организации.Очистить();
		НастройкаОбъект.ВидыДокументов.Очистить();
		НастройкаОбъект.ДатаНачалаОтражения = Неопределено;
		НастройкаОбъект.ДатаПоследнегоОбновленияУниверсальная = Неопределено;
		
		УзелОбъект = УзелОбмена.ПолучитьОбъект();
		УзелОбъект.ПравилаОтправкиСправочников = "СинхронизироватьПоНеобходимости";
		УзелОбъект.ПравилаОтправкиДокументов = "ИнтерактивнаяСинхронизация";
		
		НастройкаОбъект.Записать();
		УзелОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНастройкиБухгалтерии(ТолькоПолучениеСведений = Ложь)
	
	ДлительнаяОперация = ДлительнаяОперацияПолучитьНастройкиПриложения(УникальныйИдентификатор);
		
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДополнительныеПараметры = Новый Структура; 
	ДополнительныеПараметры.Вставить("ТолькоПолучениеСведений", ТолькоПолучениеСведений);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("ПолучитьНастройкиБухгалтерииЗавершение", ЭтотОбъект, ДополнительныеПараметры),
		ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНастройкиБухгалтерииЗавершение(Результат, ДополнительныеПараметры) Экспорт    
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.Видимость = Истина;
		Элементы.ГруппаНастройкиОтраженияВторойЭтап.ТекущаяСтраница = Элементы.СтраницаНеудача;
		Элементы.ГруппаКомандаНачать.Доступность = Истина;                
		ИзменитьДоступностьФлажковОрганизаций(Истина);
		Элементы.ГруппаДатаНачалаОтражения.Доступность = Истина;   
		Возврат;
	КонецЕсли;
	
	НастройкиБухгалтерии = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);    
	Если НастройкиБухгалтерии <> Неопределено Тогда
		НачалоРаботы = НастройкиБухгалтерии.Получить("НачалоРаботы"); 
		КоличествоОрганизаций = НастройкиБухгалтерии.Получить("КоличествоОрганизаций"); 
		БухгалтерияПуста = НачалоРаботы ИЛИ КоличествоОрганизаций = 0;    
	Иначе
		БухгалтерияПуста = Истина;
	КонецЕсли;
		
	Если БухгалтерияПуста Тогда    
		Элементы.ГруппаПредупреждениеБухгалтерияПуста.Видимость = Истина;
		Элементы.ГруппаПредупреждениеТребуетсяПолныйИнтерфейсВертикальная.Видимость = Ложь;
		Элементы.ДекорацияКартинкаИнформация.Высота = 0;
	Иначе
		Элементы.ГруппаПредупреждениеБухгалтерияНеПуста.Видимость = Истина;
		Элементы.ГруппаПредупреждениеТребуетсяПолныйИнтерфейсВертикальная.Видимость = Истина;
		Элементы.ДекорацияКартинкаИнформация.Высота = 3;
	КонецЕсли;    
	Если ДополнительныеПараметры.ТолькоПолучениеСведений Тогда   
		Возврат;
	КонецЕсли;
	
	// 2. Проброс и пометка организаций  
	ВключитьОтражениеОрганизаций();
	
КонецПроцедуры


#Область НастройкиПодключенияКПриложениюВСервисе

&НаСервереБезКонтекста
Функция ДлительнаяОперацияНастройкиПодключенияКПриложениюВСервисе(НомерОбласти, ИдентификаторФормы)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.ОтражениеДокументовВБухгалтерии.НастройкиПодключенияКПриложениюВСервисе",
		НомерОбласти);
	
КонецФункции

&НаКлиенте
Процедура ПолучитьНастройкиПодключенияКПриложениюВСервисеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь, КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ДлительнаяОперацияПроверитьПодключениеККорреспонденту(Результат.АдресРезультата, УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("ПроверитьПодключениеККорреспондентуЗавершение", ЭтотОбъект),
		ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область ПроверкаПодключенияККорреспонденту

&НаСервереБезКонтекста
Функция ДлительнаяОперацияПроверитьПодключениеККорреспонденту(АдресВХранилище, ИдентификаторФормы)
	
	НастройкиПодключенияВСервисе = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.ОтражениеДокументовВБухгалтерии.ПроверитьПодключениеККорреспонденту",
		НастройкиПодключенияВСервисе);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПодключениеККорреспондентуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь, КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ДлительнаяОперацияСохранитьНастройкиПодключения(Результат.АдресРезультата, УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("СохранитьНастройкиПодключенияЗавершение", ЭтотОбъект),
		ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область СохранениеНастроекПодключения

&НаСервереБезКонтекста
Функция ДлительнаяОперацияСохранитьНастройкиПодключения(АдресВХранилище, ИдентификаторФормы)
	
	СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.ОтражениеДокументовВБухгалтерии.СохранитьНастройкиПодключения",
		СтруктураНастроек);
	
КонецФункции

&НаКлиенте
Процедура СохранитьНастройкиПодключенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь, КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если Не ЗначениеЗаполнено(РезультатВыполнения) Тогда
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
		Возврат;
	КонецЕсли;
	
	Если РезультатВыполнения.НастройкиПодключенияСохранены Тогда
		УзелОбмена = РезультатВыполнения.УзелОбмена;
		ЗаписатьУзелОбменаВНастройкиНаСервере();
		
		ДлительнаяОперация = ДлительнаяОперацияСохранитьНачальныеНастройкиСинхронизации(ТекущаяНастройка);
	
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ДлительнаяОперация,
			Новый ОписаниеОповещения("СохранитьНачальныеНастройкиСинхронизацииЗавершение", ЭтотОбъект),
			ПараметрыОжидания);
	Иначе
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь, РезультатВыполнения.СообщениеОбОшибке);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СохранитьНачальныеНастройкиСинхронизации

&НаСервереБезКонтекста
Функция ДлительнаяОперацияСохранитьНачальныеНастройкиСинхронизации(НастройкаСсылка)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(
		ПараметрыВыполнения,
		"Обработки.ОтражениеДокументовВБухгалтерии.СохранитьНачальныеНастройкиСинхронизации",
		НастройкаСсылка);

КонецФункции

&НаКлиенте
Процедура СохранитьНачальныеНастройкиСинхронизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		ВключитьМеханизмОтраженияДокументовЗавершение(Ложь, КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	НастройкаСинхронизацииЗавершена = Истина;
	
	ВключитьМеханизмОтраженияДокументовЗавершение();
	
КонецПроцедуры

#КонецОбласти

